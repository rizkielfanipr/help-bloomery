#!/usr/bin/env bash

set -Eeuo pipefail

readonly production_path='/var/www/bloomery-office-production'
readonly staging_path='/var/www/bloomery-office-staging'
readonly lock_path='/home/deploy/.bloomery-deploy.lock'
readonly production_health_url='https://office.bloomery.co.id/up'

deployment_command="${SSH_ORIGINAL_COMMAND:-${*:-}}"
read -r action environment requested_sha unexpected_argument <<< "$deployment_command"

if [[ "$action" != 'deploy' ]] || [[ ! "$environment" =~ ^(staging|production)$ ]] || [[ ! "$requested_sha" =~ ^[0-9a-fA-F]{40}$ ]] || [[ -n "${unexpected_argument:-}" ]]; then
    echo 'Rejected deployment command.' >&2
    exit 64
fi

if [[ "$environment" == 'production' ]]; then
    application_path="$production_path"
else
    application_path="$staging_path"
fi

exec 9>"$lock_path"

if ! flock -n 9; then
    echo 'Another Bloomery deployment is already running.' >&2
    exit 75
fi

cd "$application_path"

if [[ -n "$(git status --porcelain --untracked-files=no)" ]]; then
    echo "Tracked changes exist in $application_path; deployment stopped." >&2
    exit 65
fi

git fetch --prune origin main
resolved_sha="$(git rev-parse --verify "${requested_sha}^{commit}")"
main_sha="$(git rev-parse --verify origin/main)"

if ! git merge-base --is-ancestor "$resolved_sha" "$main_sha"; then
    echo 'Requested commit is not part of origin/main.' >&2
    exit 66
fi

if [[ "$environment" == 'production' ]]; then
    staging_marker="$staging_path/.deployed-commit"

    if [[ ! -f "$staging_marker" ]] || [[ "$(<"$staging_marker")" != "$resolved_sha" ]]; then
        echo 'Requested commit has not been deployed to staging.' >&2
        exit 67
    fi

    sudo /usr/local/sbin/bloomery-db-backup
fi

previous_sha="$(git rev-parse --verify HEAD)"
maintenance_enabled=false

restore_application() {
    local exit_code=$?

    if [[ "$maintenance_enabled" == true ]]; then
        php artisan up >/dev/null 2>&1 || true
    fi

    if [[ $exit_code -ne 0 ]]; then
        echo "Deployment failed. Previous commit was $previous_sha." >&2
    fi

    exit "$exit_code"
}

trap restore_application EXIT

php artisan down --retry=60
maintenance_enabled=true

git checkout --detach "$resolved_sha"
composer install --no-dev --prefer-dist --no-interaction --no-progress --optimize-autoloader
npm ci --no-audit --no-fund
npm run build

php artisan optimize:clear
php artisan migrate --force
php artisan permissions:sync --no-interaction
php artisan optimize
php artisan queue:restart
php artisan migrate:status --no-ansi >/dev/null

printf '%s\n' "$resolved_sha" > .deployed-commit.tmp
mv .deployed-commit.tmp .deployed-commit

php artisan up
maintenance_enabled=false

if [[ "$environment" == 'production' ]]; then
    curl --fail --silent --show-error --location --max-time 30 "$production_health_url" >/dev/null
fi

echo "Bloomery $environment deployed successfully at $resolved_sha."
